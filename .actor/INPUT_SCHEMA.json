{
  "title": "일본 중고 명품 마켓 — 크로스샵 비교（Komehyo+Jackroad）",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "statsMode": {
      "title": "相場統計モード",
      "type": "boolean",
      "description": "有効にすると通常の商品プッシュではなく相場統計を1件出力します",
      "default": false
    },
    "statsKeyword": {
      "title": "相場統計フィルタキーワード",
      "type": "string",
      "description": "タイトル部分一致で絞り込み（省略可）",
      "editor": "textfield"
    },
    "searchKeyword": {
      "title": "Search Keyword",
      "type": "string",
      "description": "Search keyword",
      "prefill": "ルイヴィトン",
      "editor": "textfield"
    },
    "maxItems": {
      "title": "Max Items",
      "type": "integer",
      "description": "Max items to collect",
      "default": 100,
      "minimum": 1
    },
    "maxPages": {
      "title": "Max Pages",
      "type": "integer",
      "description": "Max pages per source",
      "default": 2,
      "minimum": 1
    },
    "sources": {
      "title": "Sources",
      "type": "string",
      "description": "Comma-separated sources",
      "default": "komehyo,jackroad",
      "editor": "textfield"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "editor": "proxy",
      "description": "Apify proxy configuration",
      "default": {
        "useApifyProxy": true
      },
      "prefill": {
        "useApifyProxy": true
      }
    }
  },
  "required": []
}
